{
  "name": "creator-rig",
  "version": "0.1.0",
  "private": true,
  "description": "Throwaway stress rig for the Creator web runtime decision (CW-01). Opens scenarios by URL, prints one JSON report per run.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host",
    "rig": "vite --host --open",
    "build": "vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vite build && playwright test",
    "bench:chromium": "vite build && playwright test --project=chromium",
    "bench:webkit": "vite build && playwright test --project=webkit",
    "results": "node scripts/summarize.mjs",
    "ktx": "node scripts/make-ktx.mjs",
    "atlas": "node scripts/pack-atlas.mjs"
  },
  "dependencies": {
    "@dimforge/rapier2d-deterministic-compat": "^0.20.0",
    "@esotericsoftware/spine-phaser-v4": "4.2.120",
    "phaser": "4.2.1",
    "phaser-box2d": "^1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@gpu-tex-enc/astc": "^4.7.1",
    "@gpu-tex-enc/bc": "^1.0.11",
    "@gpu-tex-enc/etc": "^1.0.3",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "dxt-js": "^0.0.3",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
