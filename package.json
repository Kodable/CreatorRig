{
  "name": "creator-rig",
  "version": "0.1.0",
  "private": true,
  "description": "Throwaway stress rig for the Creator web runtime decision (CW-01). Opens scenarios by URL, prints one JSON report per run.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host",
    "rig": "vite --host --open",
    "build": "vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vite build && playwright test",
    "bench:chromium": "vite build && playwright test --project=chromium",
    "bench:webkit": "vite build && playwright test --project=webkit",
    "results": "node scripts/summarize.mjs"
  },
  "dependencies": {
    "@dimforge/rapier2d-deterministic-compat": "^0.20.0",
    "phaser": "4.2.1",
    "phaser-box2d": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
